# Optional local override. The maps commands otherwise read the encrypted key from AWS Parameter Store.
# Google Cloud: enable Maps JavaScript API, Places API (New), and Routes API.
# Restrict this browser key to your website's HTTP referrers and these APIs.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: your own JavaScript map ID. DEMO_MAP_ID is used when omitted.
VITE_GOOGLE_MAPS_MAP_ID=

# Existing Subscription Scanner Lambda Function URL, when using that feature.
VITE_SUBSCRIPTION_SCANNER_API_URL=
